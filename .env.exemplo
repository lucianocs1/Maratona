# Copie para .env (ignorado pelo git) e preencha. Nunca coloque valores reais neste arquivo de exemplo.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fazendadb

# IA (opcional). Sem estas linhas, o copiloto e o "Pergunte ao painel" usam o provedor simulado.
# FAROL_IA=anthropic
# ANTHROPIC_API_KEY=
# FAROL_IA_MODELO=claude-haiku-5-5

# Voz feminina na nuvem (opcional; só o texto do aviso sai do servidor). Sem estas linhas vale a voz local (Piper, masculina).
# FAROL_VOZ_NUVEM=google
# GOOGLE_TTS_KEY=
# (ou FAROL_VOZ_NUVEM=azure com AZURE_SPEECH_KEY e AZURE_SPEECH_REGION=brazilsouth)
# FAROL_VOZ_NUVEM_NOME=pt-BR-Chirp3-HD-Leda
